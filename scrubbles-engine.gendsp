          "code": "// Free travel or transport-locked input phase. All histories are per instance.\nParam seed(5, min=0, max=5);\nParam position(0, min=0, max=1);\nParam rate(0.25, min=0.02, max=8);\nParam running(1, min=0, max=1);\nParam sync(1, min=0, max=1);\nParam hostplaying(0, min=0, max=1);\nParam reverse(0, min=0, max=1);\nParam bipolar(1, min=0, max=1);\nParam grabbed(0, min=0, max=1);\nParam seekposition(0, min=0, max=1);\nParam seekgeneration(0, min=0, max=999999);\nParam markerseek(0, min=0, max=1);\nParam gridgeneration(0, min=0, max=999999);\nHistory phase(0);\nHistory previousoffset(0);\nHistory previousseek(0);\nHistory griddisplacement(0);\nHistory previousgrid(0);\n\n// Marker seeks displace the synced phase without changing Position. The bridge\n// returns to grid on Hold/grab release, Run re-enable, host Play, or entering Sync.\n// Clearing displacement never moves a stopped/held position by itself.\ndisplacement = griddisplacement;\nif (gridgeneration != previousgrid) {\n    displacement = 0;\n}\np = phase;\nif (seekgeneration != previousseek && markerseek != 0) {\n    p = seekposition;\n    displacement = p - ((reverse != 0 ? -in1 : in1) + position);\n} else if (grabbed != 0) {\n    // A marker replaces this coordinate until the next mouse drag/release.\n    p = seekposition;\n} else if (sync != 0 && running != 0 && hostplaying != 0) {\n    p = wrap((reverse != 0 ? -in1 : in1) + position + displacement, 0, 1);\n} else if (seekgeneration != previousseek) {\n    p = seekposition;\n} else if (position != previousoffset) {\n    p = wrap(p + position - previousoffset, 0, 1);\n}\npreviousoffset = position;\npreviousseek = seekgeneration;\npreviousgrid = gridgeneration;\ngriddisplacement = displacement;\n\n// Contours exactly match the original engine, including right-continuous\n// steps and the endpoint at p == 1 while grabbing or stopped after release.\nc = 0;\nif (seed < 0.5) {\n    c = p;\n} else if (seed < 1.5) {\n    c = 1 - abs(2 * p - 1);\n} else if (seed < 2.5) {\n    if (p >= 0.35 && p < 0.40) {\n        c = (p - 0.35) / 0.05;\n    } else if (p >= 0.40 && p < 0.50) {\n        c = (0.50 - p) / 0.10;\n    }\n} else if (seed < 3.5) {\n    if (p < 0.25) {\n        c = 0;\n    } else if (p < 0.50) {\n        c = 1 / 3;\n    } else if (p < 0.75) {\n        c = 2 / 3;\n    } else {\n        c = 1;\n    }\n} else if (seed < 4.5) {\n    c = p >= 0.25 && p < 0.75;\n} else {\n    // (0,.12), (.16,.12), (.22,1), (.28,.80), (.36,.80),\n    // (.36,.58), (.46,.58), (.46,.36), (.58,.36), (1,.12).\n    if (p < 0.16) {\n        c = 0.12;\n    } else if (p < 0.22) {\n        c = 0.12 + 0.88 * (p - 0.16) / 0.06;\n    } else if (p < 0.28) {\n        c = 1 - 0.20 * (p - 0.22) / 0.06;\n    } else if (p < 0.36) {\n        c = 0.80;\n    } else if (p < 0.46) {\n        c = 0.58;\n    } else if (p < 0.58) {\n        c = 0.36;\n    } else {\n        c = 0.36 - 0.24 * (p - 0.58) / 0.42;\n    }\n}\n\n// Amount is applied by live.modulate~ depth, not here.\nout1 = bipolar != 0 ? 2 * c - 1 : c;\nout2 = p;\nout3 = c;\n\n// The bridge combines Run and Hold into running; grabbing independently pauses travel.\n// Seek already consumed the final release coordinate before this increment.\nnextphase = p;\nif (sync == 0 && running != 0 && grabbed == 0) {\n    direction = reverse != 0 ? -1 : 1;\n    nextphase = wrap(p + direction * rate / samplerate, 0, 1);\n}\nphase = nextphase;\n"
        }
      },
